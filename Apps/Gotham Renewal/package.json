{
  "name": "gotham-renewal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check:oversell": "tsx scripts/check-oversell.ts",
    "check:e2e": "tsx scripts/check-e2e.ts",
    "admin:hash": "tsx scripts/hash-admin-password.ts",
    "check:admin": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-admin.ts",
    "check:admin-browser": "tsx scripts/check-admin-browser.ts",
    "jobs:notifications": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/run-notification-jobs.ts",
    "check:outbox": "LOG_LEVEL=error NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-outbox.ts",
    "check:webhook-idempotency": "LOG_LEVEL=error NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-webhook-idempotency.ts",
    "check:webhook-route": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-webhook-route.ts",
    "check:sweep": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-sweep.ts",
    "check:products": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-products.ts",
    "check:products-browser": "tsx scripts/check-products-browser.ts",
    "check:orders": "LOG_LEVEL=error NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-orders.ts",
    "check:refunds": "LOG_LEVEL=error NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-refunds.ts",
    "check:database": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/check-database.ts",
    "check:deploy": "tsx scripts/check-deploy.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
