# ---------------------------------------------------------------------------
# Gotham Renewal - environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER put secrets in NEXT_PUBLIC_* variables: anything with that prefix is
# inlined into the browser bundle and is world-readable.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
#
# TWO variables, and they are not interchangeable. Both point at the same
# database; they differ in how the connection is pooled.
#
#  DATABASE_URL  used by the APP at runtime. In production this is the pooler,
#                because Vercel opens many short-lived connections and Postgres
#                cannot take one backend per connection.
#
#  DIRECT_URL    used by the PRISMA CLI (migrate, studio, db push). A migration
#                holds one session across many statements and takes advisory
#                locks, which a transaction-mode pooler cannot provide - it may
#                hand each statement to a different backend.
#
# DIRECT_URL is read only by prisma.config.ts, and falls back to DATABASE_URL
# when unset, so local development needs just the one variable.

# --- Local development (default) -------------------------------------------
# Postgres via Homebrew/conda, created by `npm run db:setup`.
# The session timezone MUST be UTC or timestamps shift silently - see
# src/lib/db/connection.ts. withUtcSession() enforces it on the connection.
DATABASE_URL="postgresql://gotham:gotham@127.0.0.1:5432/gotham_renewal?schema=public"

# --- Supabase (production / staging) ---------------------------------------
# Supabase dashboard -> Connect. Copy the POOLER strings, not the direct one:
# newer direct hosts are IPv6-only and Vercel's egress is unreliable over IPv6.
#
#   DATABASE_URL -> Transaction pooler,  port 6543
#   DIRECT_URL   -> Session pooler,      port 5432
#
# Shape (the dashboard fills the host and ref in for you):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# If the password contains @ : / or ?, it MUST be URL-encoded.
#
# DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Session timezone -------------------------------------------------------
# withUtcSession() appends `options=-c timezone=UTC` to the connection string.
# That is REQUIRED on a host whose server timezone is not UTC (e.g. local
# Postgres on this machine, Asia/Kolkata) and redundant on Supabase, which runs
# UTC already.
#
# Set this to "false" ONLY when the database is guaranteed UTC - i.e. pointed at
# Supabase with `ALTER DATABASE postgres SET timezone='UTC'` applied. Leaving it
# false against a non-UTC server reintroduces the silent 5.5-hour shift that
# once made a worker lease look expired and caused duplicate sends.
# DB_SESSION_UTC="false"

# --- Business / storefront -------------------------------------------------
# The display name lives in src/lib/site.ts. There is deliberately no
# NEXT_PUBLIC_* variable for it: that prefix means "inline into the browser
# bundle", and nothing here needs to be.
# Absolute base URL. Used to build the "view order" link in WhatsApp messages
# and, later, Razorpay callback URLs. Must have no trailing slash.
APP_BASE_URL="http://localhost:3000"
# The WhatsApp number that receives "new order" alerts, in E.164 format
# (country code, no +, no spaces). Example for India: 919876543210
ORDER_NOTIFICATION_NUMBER=""

# --- Money -----------------------------------------------------------------
# Shipping charged per order, in paise (integer). 0 = free shipping.
# Example: 5000 paise = Rs.50
SHIPPING_FEE_PAISE="0"
# Orders at or above this subtotal (paise) ship free. Set to 0 to disable.
FREE_SHIPPING_THRESHOLD_PAISE="0"
# Order-number prefix. Order numbers read like GR-1042.
#
# DELIBERATE QUIRK, not a mistake: "GR" stands for Gotham Renewal, the project's
# name, while the shop is Sri Srinivasa Boli Stall. It is kept on purpose - the
# numbers are part of how this system feels, and changing it would rewrite the
# format on order confirmations and WhatsApp alerts that already exist.
# Change it only if the shop asks for SSBS-1042 and accepts that old orders keep
# the old format.
ORDER_NUMBER_PREFIX="GR"

# --- Admin -----------------------------------------------------------------
# Password for /admin.
#
# Two accepted forms:
#   1. Plaintext - simple to start with, but readable by anyone who can see the
#      environment. Fine for local development.
#   2. A scrypt hash - generate one with:
#        npm run admin:hash -- "your long password"
#      and paste the "scrypt$..." value here. Use this in production.
ADMIN_PASSWORD="change-me-to-a-long-random-string"
# Secret used to sign the admin session cookie. 32+ random bytes, hex or base64.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Rotating this signs every admin out immediately - that is the revocation
# mechanism, since sessions are signed cookies rather than database rows.
ADMIN_SESSION_SECRET=""

# --- Razorpay (Phase 10-11) ------------------------------------------------
# Test-mode keys start with rzp_test_ ; live-mode keys start with rzp_live_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- WhatsApp Cloud API (Phase 9) ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
META_GRAPH_VERSION="v21.0"

# --- Product image uploads (optional) --------------------------------------
# Without these, the image uploader is disabled and the admin pastes an image
# URL instead. The service-role key is used SERVER-SIDE ONLY to write to the
# public bucket; it must never be exposed to the browser.
# Create a public bucket named "product-images" in Supabase Storage first.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# --- Rate limiting (recommended in production) -----------------------------
# Without these, rate limiting falls back to an IN-MEMORY counter that is per
# server instance. On Vercel that means the effective limit is multiplied by
# however many instances are warm, so it is not a real distributed limit.
#
# Create a free Redis database at https://upstash.com and copy the REST URL and
# token from its dashboard. The app logs which backend is active at startup.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Logging (optional) ----------------------------------------------------
# "debug" | "info" | "warn" | "error". Defaults to "info".
# Bearer token for /api/jobs/notifications (the outbox worker). Used by a
# self-hosted scheduler or manual runs.
# Generate: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
JOB_RUNNER_SECRET=""

# Same endpoint, Vercel's own convention. When this is set on a Vercel project,
# Vercel Cron automatically sends it as "Authorization: Bearer $CRON_SECRET".
# Set it to the same value as JOB_RUNNER_SECRET for one secret to govern both,
# or leave it unset outside Vercel.
CRON_SECRET=""

# --- Logging (optional) ---"info"
